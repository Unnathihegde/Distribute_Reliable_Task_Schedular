# =============================================================================
# Distributed Reliable Task Scheduler — Environment Configuration
# =============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# The docker-compose.yml and application.yml have built-in defaults,
# so .env is optional for local development.
# =============================================================================

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taskscheduler
DB_USER=scheduler
DB_PASSWORD=scheduler_password

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=scheduler
RABBITMQ_PASSWORD=scheduler_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
