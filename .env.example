# =============================================================================
# Distributed Reliable Task Scheduler — Environment Variables Example
# Copy this file to .env and configure secret credentials for deployment.
# =============================================================================

# API Key Authentication (Required by API Service)
API_KEY=dev-secret-api-key

# PostgreSQL Credentials
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taskscheduler
DB_USER=scheduler
DB_PASSWORD=scheduler_password

# RabbitMQ Credentials
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=scheduler
RABBITMQ_PASSWORD=scheduler_password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Rate Limiting Permits (API Service)
RATE_LIMIT_PERMITS=100000

# OpenTelemetry / Jaeger Tracing Endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Grafana Monitoring
GRAFANA_ADMIN_PASSWORD=admin

